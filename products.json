<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاحص أسعار المنتجات</title>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            text-align: center; color: #f8fafc; min-height: 100vh; padding: 20px 15px;
            background: linear-gradient(-45deg, #0f172a, #1e1b4b, #111827, #0f2942);
            background-size: 400% 400%; animation: gradientBG 12s ease infinite;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .header-title { color: #fff; font-size: 22px; font-weight: 700; margin-bottom: 20px; }
        #reader { width: 100%; max-width: 400px; margin: 0 auto 15px; border-radius: 16px; overflow: hidden; background: #1e293b; border: 1px solid #334155; min-height: 220px; }
        .controls { display: flex; justify-content: center; gap: 10px; max-width: 400px; margin: 0 auto 15px; flex-wrap: wrap; }
        #result-box { background: rgba(30, 41, 59, 0.9); backdrop-filter: blur(8px); padding: 20px; border-radius: 16px; border: 1px solid #334155; max-width: 400px; margin: 0 auto; }
        #product-image { width: 100%; max-height: 350px; object-fit: contain; border-radius: 12px; display: none; margin-top: 15px; border: 1px solid #475569; }
        .status { font-size: 16px; font-weight: 600; color: #cbd5e1; line-height: 1.6; }
        .price-tag { font-size: 20px; color: #10b981; font-weight: bold; margin-top: 8px; }
        button { border: none; padding: 12px 14px; font-size: 14px; font-weight: bold; border-radius: 12px; cursor: pointer; transition: 0.2s; }
        .btn-scan { background: linear-gradient(135deg, #10b981, #059669); color: white; width: 100%; }
        .btn-camera-direct { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; width: 100%; margin-bottom: 10px; }
        .btn-torch { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; flex: 1; }
        .btn-gallery { background: linear-gradient(135deg, #0284c7, #0369a1); color: white; flex: 1; }
        input[type="file"] { display: none; }
    </style>
</head>
<body>

    <div class="header-title">🔍 فاحص أسعار المنتجات</div>
    <div id="reader"></div>

    <div class="controls">
        <button class="btn-camera-direct" onclick="document.getElementById('native-camera-file').click()">📷 التقاط صورة بالباركود فوراً</button>
        <button id="torch-btn" class="btn-torch" onclick="toggleTorch()">💡 الفلاش: إيقاف</button>
        <button class="btn-gallery" onclick="document.getElementById('qr-input-file').click()">🖼️ المعرض</button>
    </div>

    <input type="file" id="qr-input-file" accept="image/*" onchange="scanImageFromFile(event)">
    <input type="file" id="native-camera-file" accept="image/*" capture="environment" onchange="scanImageFromFile(event)">

    <div id="result-box">
        <div id="barcode-result" class="status">جاري تشغيل الكاميرا...</div>
        <img id="product-image" alt="صورة المنتج المسعر" />
        <button class="btn-scan" style="margin-top:15px;" onclick="restartScanner()">مسح منتج آخر</button>
    </div>

    <script>
        // 🔗 رابط بياناتك المباشر من GitHub
        const GITHUB_JSON_URL = "https://raw.githubusercontent.com/Abdulmajed1/products/main/products.json";

        let html5QrCode;
        let isTorchOn = false;
        let productsDatabase = {};

        async function fetchProductsFromGitHub() {
            try {
                const response = await fetch(GITHUB_JSON_URL + "?t=" + new Date().getTime());
                if (response.ok) {
                    productsDatabase = await response.json();
                }
            } catch (error) {
                console.log("تعذر جلب البيانات من GitHub");
            }
        }

        async function startScanner() {
            await fetchProductsFromGitHub();
            document.getElementById('product-image').style.display = "none";
            document.getElementById('barcode-result').innerText = "وجه الكاميرا نحو الباركود...";

            if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");

            try {
                const config = { fps: 10, qrbox: { width: 250, height: 150 } };
                await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess);
            } catch (err) {
                document.getElementById('barcode-result').innerText = "يرجى السماح بالكاميرا أو استخدام الأزرار بالأسفل.";
            }
        }

        function handleBarcodeFound(decodedText) {
            const cleanBarcode = decodedText.trim();
            const imgElement = document.getElementById('product-image');
            imgElement.style.display = "none";

            const product = productsDatabase[cleanBarcode];

            if (product) {
                let htmlContent = `<b>الباركود:</b> ${cleanBarcode}<br>`;
                if (product.name) htmlContent += `<b>المنتج:</b> ${product.name}<br>`;
                if (product.price) htmlContent += `<div class="price-tag">${product.price}</div>`;

                document.getElementById('barcode-result').innerHTML = htmlContent;

                if (product.image) {
                    imgElement.src = product.image;
                    imgElement.style.display = "block";
                }
            } else {
                document.getElementById('barcode-result').innerHTML = `
                    <b>الباركود:</b> ${cleanBarcode}<br>
                    <span style="color:#ef4444; font-weight:bold;">❌ هذا المنتج غير مسجل في القائمة</span>
                `;
            }
        }

        function onScanSuccess(decodedText) {
            html5QrCode.stop().then(() => handleBarcodeFound(decodedText));
        }

        async function scanImageFromFile(event) {
            if (event.target.files.length === 0) return;
            const imageFile = event.target.files[0];
            if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
            if (html5QrCode.isScanning) await html5QrCode.stop();

            document.getElementById('barcode-result').innerText = "جاري قراءة الباركود...";
            try {
                const decodedText = await html5QrCode.scanFile(imageFile, true);
                handleBarcodeFound(decodedText);
            } catch (err) {
                document.getElementById('barcode-result').innerText = "❌ لم يتم التعرف على الباركود في الصورة.";
            }
            event.target.value = "";
        }

        async function toggleTorch() {
            if (!html5QrCode || !html5QrCode.isScanning) return alert("الفلاش يعمل مع الكاميرا المباشرة فقط.");
            try {
                isTorchOn = !isTorchOn;
                await html5QrCode.applyVideoConstraints({ advanced: [{ torch: isTorchOn }] });
                document.getElementById('torch-btn').innerText = isTorchOn ? "💡 الفلاش: تشغيل" : "💡 الفلاش: إيقاف";
            } catch (err) {
                alert("الفلاش غير مدعوم في هذا الجهاز.");
            }
        }

        function restartScanner() { startScanner(); }
        window.onload = startScanner;
    </script>
</body>
</html>
